{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "rows"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "opportunity_table"
        },
        "title": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "opportunity_id",
              "client_id",
              "client_name",
              "title",
              "priority",
              "stage",
              "source_ids",
              "status_note"
            ],
            "properties": {
              "opportunity_id": {
                "type": "string"
              },
              "client_id": {
                "type": "string"
              },
              "client_name": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "priority": {
                "enum": [
                  "High",
                  "Medium",
                  "Low"
                ]
              },
              "stage": {
                "enum": [
                  "New",
                  "Reviewing",
                  "Reviewed"
                ]
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status_note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "x_label",
        "y_label",
        "series"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "bar_chart"
        },
        "title": {
          "type": "string"
        },
        "x_label": {
          "type": "string"
        },
        "y_label": {
          "type": "string"
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "items"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "evidence_cards"
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "excerpt",
              "interpretation"
            ],
            "properties": {
              "source_id": {
                "type": "string"
              },
              "excerpt": {
                "type": "string"
              },
              "interpretation": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "client_id",
        "opportunity_id",
        "subject",
        "body"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "review_form"
        },
        "title": {
          "type": "string"
        },
        "client_id": {
          "type": "string"
        },
        "opportunity_id": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      }
    }
  ]
}
